+void DeferredCommandBuffer::BeginHoist(VkBuffer buffer, VkPipelineStageFlags read_stage_mask,
+                                       VkAccessFlags read_access_mask) {
+  assert_true(open_pass_header_offset_ != kNoPass);
+  assert_true(write_stream_ == &command_stream_);
+  write_stream_ = &hoist_stream_;
+  if (hoist_blocks_.empty() || hoist_blocks_.back().anchor != open_pass_header_offset_ ||
+      hoist_blocks_.back().buffer != buffer) {
+    hoist_blocks_.push_back({open_pass_header_offset_, hoist_stream_.size(), hoist_stream_.size(),
+                             buffer, read_stage_mask, read_access_mask});
+  }
+}
+
+void DeferredCommandBuffer::EndHoist() {
+  hoist_blocks_.back().end = hoist_stream_.size();
+  write_stream_ = &command_stream_;
+}
+
+size_t DeferredCommandBuffer::BeginHoistRegion() {
+  assert_true(open_pass_header_offset_ != kNoPass);
+  assert_true(write_stream_ == &command_stream_);
+  // A block of its own (no buffer: no barriers around it from Execute).
+  hoist_blocks_.push_back({open_pass_header_offset_, hoist_stream_.size(), hoist_stream_.size(),
+                           VK_NULL_HANDLE, 0, 0});
+  write_stream_ = &hoist_stream_;
+  const size_t region_start = hoist_stream_.size();
+  // Order the region after everything hoisted before it for this pass (copies whose barrier Execute only
+  // writes at the end of their block).
+  VkMemoryBarrier barrier = {};
+  barrier.sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER;
+  barrier.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT | VK_ACCESS_SHADER_WRITE_BIT;
+  barrier.dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_TRANSFER_WRITE_BIT |
+                          VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT;
+  CmdVkPipelineBarrier(VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 1,
+                       &barrier, 0, nullptr, 0, nullptr);
+  hoist_region_after_barrier_ = hoist_stream_.size();
+  return region_start;
+}
+
+void DeferredCommandBuffer::EndHoistRegion() {
+  HoistBlock& block = hoist_blocks_.back();
+  if (hoist_stream_.size() == hoist_region_after_barrier_) {
+    // Nothing recorded besides the barrier (the usual case: no texture to load): drop the region.
+    hoist_stream_.resize(block.begin);
+    hoist_blocks_.pop_back();
+  } else {
+    block.end = hoist_stream_.size();
+  }
+  write_stream_ = &command_stream_;
+}
+
+void DeferredCommandBuffer::TakeHoistRegion(size_t region_start, std::vector<uintmax_t>& commands_out) {
+  assert_true(write_stream_ == &hoist_stream_);
+  commands_out.assign(hoist_stream_.begin() + region_start, hoist_stream_.end());
+  hoist_stream_.resize(region_start);
+  HoistBlock& block = hoist_blocks_.back();
+  block.end = region_start;
+  if (block.begin == block.end) {
+    hoist_blocks_.pop_back();
+  }
+  write_stream_ = &command_stream_;
+}
+
+void DeferredCommandBuffer::AppendRaw(const std::vector<uintmax_t>& commands) {
+  assert_true(write_stream_ == &command_stream_);
+  command_stream_.insert(command_stream_.end(), commands.begin(), commands.end());
+}
+
+DeferredCommandBuffer::ProfilePool* DeferredCommandBuffer::ProfileBegin(
+    VkCommandBuffer command_buffer) {
+  if (profile_failed_) {
+    return nullptr;
+  }
+  const ui::vulkan::VulkanDevice* vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  ProfilePool& pool = profile_pools_[profile_pool_index_];
+  if (pool.pool == VK_NULL_HANDLE) {
+    if (profile_pool_index_ == 0) {
+      VkPhysicalDeviceProperties properties;
+      vulkan_device->vulkan_instance()->functions().vkGetPhysicalDeviceProperties(
+          vulkan_device->physical_device(), &properties);
+      timestamp_period_ns_ = properties.limits.timestampPeriod;
+      if (!properties.limits.timestampComputeAndGraphics) {
+        REXGPU_WARN("gpuprof: the device has no graphics/compute timestamps");
+        profile_failed_ = true;
+        return nullptr;
+      }
+      REXGPU_INFO("gpuprof: on, timestamp period {} ns", timestamp_period_ns_);
+    }
+    VkQueryPoolCreateInfo pool_info = {};
+    pool_info.sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO;
+    pool_info.queryType = VK_QUERY_TYPE_TIMESTAMP;
+    pool_info.queryCount = kProfileQueriesPerPool;
+    if (dfn.vkCreateQueryPool(vulkan_device->device(), &pool_info, nullptr, &pool.pool) !=
+        VK_SUCCESS) {
+      REXGPU_WARN("gpuprof: vkCreateQueryPool failed");
+      profile_failed_ = true;
+      return nullptr;
+    }
+  } else if (pool.pending) {
+    ProfileCollect(pool);
+    if (pool.pending) {
+      // The submission that used this pool has not finished: skip timing this one.
+      return nullptr;
+    }
+  }
+  profile_pool_index_ = (profile_pool_index_ + 1) % kProfilePoolCount;
+  dfn.vkCmdResetQueryPool(command_buffer, pool.pool, 0, kProfileQueriesPerPool);
+  pool.stamps.clear();
+  pool.pending = true;
+  ProfileStampWrite(command_buffer, &pool, kSegOther);
+  return &pool;
+}
+
+void DeferredCommandBuffer::ProfileStampWrite(VkCommandBuffer command_buffer, ProfilePool* pool,
+                                              SegmentKind kind, uint32_t draws, uint32_t width,
+                                              uint32_t height) {
+  if (pool->stamps.size() >= kProfileQueriesPerPool) {
+    return;
+  }
+  command_processor_.GetVulkanDevice()->functions().vkCmdWriteTimestamp(
+      command_buffer, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, pool->pool,
+      uint32_t(pool->stamps.size()));
+  pool->stamps.push_back({uint8_t(kind), draws, width, height});
+}
+
+void DeferredCommandBuffer::ProfileCollect(ProfilePool& pool) {
+  const ui::vulkan::VulkanDevice* vulkan_device = command_processor_.GetVulkanDevice();
+  const uint32_t count = uint32_t(pool.stamps.size());
+  if (count < 2) {
+    pool.pending = false;
+    return;
+  }
+  static thread_local std::vector<uint64_t> results;
+  results.resize(count);
+  if (vulkan_device->functions().vkGetQueryPoolResults(
+          vulkan_device->device(), pool.pool, 0, count, sizeof(uint64_t) * count, results.data(),
+          sizeof(uint64_t), VK_QUERY_RESULT_64_BIT) != VK_SUCCESS) {
+    return;  // VK_NOT_READY: still pending
+  }
+  pool.pending = false;
+  const double ms_per_tick = double(timestamp_period_ns_) / 1e6;
+  for (uint32_t i = 1; i < count; ++i) {
+    const ProfileStamp& stamp = pool.stamps[i];
+    const double ms =
+        results[i] > results[i - 1] ? double(results[i] - results[i - 1]) * ms_per_tick : 0.0;
+    profile_window_ms_[stamp.kind] += ms;
+    ++profile_window_count_[stamp.kind];
+    if (stamp.kind != kSegOther && ms > 0.25) {
+      profile_top_.push_back({ms, stamp.kind, stamp.draws, stamp.width, stamp.height});
+    }
+  }
+  profile_window_span_ms_ +=
+      results[count - 1] > results[0] ? double(results[count - 1] - results[0]) * ms_per_tick : 0.0;
+  ++profile_window_submissions_;
+
+  const uint64_t now_ns = uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                       std::chrono::steady_clock::now().time_since_epoch())
+                                       .count());
+  if (!profile_window_start_ns_) {
+    profile_window_start_ns_ = now_ns;
+  }
+  if (now_ns - profile_window_start_ns_ < 3000000000ull) {
+    return;
+  }
+  const double n = double(profile_window_submissions_);
+  REXGPU_INFO(
+      "gpuprof: {} submissions, GPU ms per submission: span {:.2f} | guest passes {:.2f} ({:.0f}) | "
+      "rt-cache passes {:.2f} ({:.0f}) | present {:.2f} | dispatch {:.2f} ({:.0f}) | hoisted {:.2f} "
+      "({:.0f}) | other {:.2f}",
+      profile_window_submissions_, profile_window_span_ms_ / n, profile_window_ms_[kSegPassGuest] / n,
+      profile_window_count_[kSegPassGuest] / n, profile_window_ms_[kSegPassRenderTargetCache] / n,
+      profile_window_count_[kSegPassRenderTargetCache] / n, profile_window_ms_[kSegPassPresent] / n,
+      profile_window_ms_[kSegDispatch] / n, profile_window_count_[kSegDispatch] / n,
+      profile_window_ms_[kSegHoisted] / n, profile_window_count_[kSegHoisted] / n,
+      profile_window_ms_[kSegOther] / n);
+  std::sort(profile_top_.begin(), profile_top_.end(),
+            [](const ProfileTop& a, const ProfileTop& b) { return a.ms > b.ms; });
+  GpuProfileCounters& counters = gpu_profile_counters();
+  REXGPU_INFO(
+      "gpuprof: per submission: {:.0f} guest memory uploads, {:.0f} KB; {:.1f} texture loads, {:.0f} KB",
+      double(counters.uploads.exchange(0)) / n, double(counters.upload_bytes.exchange(0)) / 1024.0 / n,
+      double(counters.texture_loads.exchange(0)) / n,
+      double(counters.texture_load_bytes.exchange(0)) / 1024.0 / n);
+  static const char* const kKindNames[] = {"guest",    "rt-cache", "present",
+                                           "dispatch", "other",    "hoisted"};
+  for (size_t i = 0; i < std::min<size_t>(profile_top_.size(), 12); ++i) {
+    const ProfileTop& top = profile_top_[i];
+    REXGPU_INFO("gpuprof:   {:.2f} ms {} draws={} {}x{}", top.ms, kKindNames[top.kind], top.draws,
+                top.width, top.height);
+  }
+  profile_top_.clear();
+  profile_window_start_ns_ = now_ns;
+  profile_window_submissions_ = 0;
+  profile_window_span_ms_ = 0.0;
+  for (uint32_t i = 0; i < kSegKindCount; ++i) {
+    profile_window_ms_[i] = 0.0;
+    profile_window_count_[i] = 0;
+  }
+}
