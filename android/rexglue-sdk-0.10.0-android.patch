+namespace rex {
+
+namespace {
+
+// Writes to stderr (the log file, see windowed_app_main_sdl.cpp) and logcat. Async-signal-safe enough for a crash
+// report: no allocation, fixed buffers.
+void Say(const char* line, size_t length) {
+  (void)!write(2, line, length);
+  __android_log_write(ANDROID_LOG_ERROR, "rexglue", line);
+}
+
+void SayF(const char* format, ...) __attribute__((format(printf, 1, 2)));
+void SayF(const char* format, ...) {
+  char line[768];
+  va_list args;
+  va_start(args, format);
+  int length = vsnprintf(line, sizeof(line), format, args);
+  va_end(args);
+  if (length < 0) {
+    return;
+  }
+  if (size_t(length) >= sizeof(line)) {
+    length = sizeof(line) - 1;
+  }
+  Say(line, size_t(length));
+}
+
+// "<file>+0x<offset> (<symbol>+0x<offset>)" for one code address.
+void PrintFrame(int index, uintptr_t pc) {
+  Dl_info info{};
+  if (pc && dladdr(reinterpret_cast<void*>(pc), &info) && info.dli_fname) {
+    const char* file = std::strrchr(info.dli_fname, '/');
+    file = file ? file + 1 : info.dli_fname;
+    const uintptr_t base = reinterpret_cast<uintptr_t>(info.dli_fbase);
+    if (info.dli_sname) {
+      SayF("  #%02d pc %016llx  %s+0x%llx (%s+0x%llx)\n", index, (unsigned long long)pc, file,
+           (unsigned long long)(pc - base), info.dli_sname,
+           (unsigned long long)(pc - reinterpret_cast<uintptr_t>(info.dli_saddr)));
+    } else {
+      SayF("  #%02d pc %016llx  %s+0x%llx\n", index, (unsigned long long)pc, file,
+           (unsigned long long)(pc - base));
+    }
+  } else {
+    SayF("  #%02d pc %016llx  ?\n", index, (unsigned long long)pc);
+  }
+}
+
+// The /proc/self/maps line holding address (guest memory, a stack, a library), or "not mapped".
+void PrintMapping(const char* what, uintptr_t address) {
+  int fd = open("/proc/self/maps", O_RDONLY | O_CLOEXEC);
+  if (fd < 0) {
+    return;
+  }
+  char text[4096];
+  size_t have = 0;
+  bool found = false;
+  while (!found) {
+    ssize_t got = read(fd, text + have, sizeof(text) - 1 - have);
+    if (got <= 0) {
+      break;
+    }
+    have += size_t(got);
+    text[have] = 0;
+    char* line = text;
+    char* newline;
+    while ((newline = std::strchr(line, '\n'))) {
+      *newline = 0;
+      unsigned long long start = 0, end = 0;
+      if (std::sscanf(line, "%llx-%llx", &start, &end) == 2 && address >= start && address < end) {
+        SayF("  %s %llx in %s\n", what, (unsigned long long)address, line);
+        found = true;
+        break;
+      }
+      line = newline + 1;
+    }
+    have = std::strlen(line);
+    std::memmove(text, line, have);
+  }
+  close(fd);
+  if (!found) {
+    SayF("  %s %llx is not mapped\n", what, (unsigned long long)address);
+  }
+}
+
+// Bounds of the mapping holding address (from /proc/self/maps); false when it is not mapped.
+bool FindMapping(uintptr_t address, uintptr_t* start_out, uintptr_t* end_out) {
+  int fd = open("/proc/self/maps", O_RDONLY | O_CLOEXEC);
+  if (fd < 0) {
+    return false;
+  }
+  char text[4096];
+  size_t have = 0;
+  bool found = false;
+  while (!found) {
+    ssize_t got = read(fd, text + have, sizeof(text) - 1 - have);
+    if (got <= 0) {
+      break;
+    }
+    have += size_t(got);
+    text[have] = 0;
+    char* line = text;
+    char* newline;
+    while ((newline = std::strchr(line, '\n'))) {
+      *newline = 0;
+      unsigned long long start = 0, end = 0;
+      if (std::sscanf(line, "%llx-%llx", &start, &end) == 2 && address >= start && address < end) {
+        *start_out = uintptr_t(start);
+        *end_out = uintptr_t(end);
+        found = true;
+        break;
+      }
+      line = newline + 1;
+    }
+    have = std::strlen(line);
+    std::memmove(text, line, have);
+  }
+  close(fd);
+  return found;
+}
+
+// pc, lr, then the frame records {previous x29, return address} from the interrupted registers. No unwinder:
+// libunwind authenticates signed return addresses (pointer authentication) and traps on frames of the Java
+// runtime. Records are only read inside the thread's stack mapping; return addresses lose their PAC bits.
+void WalkFrames(const ucontext_t* uc) {
+  constexpr uintptr_t kAddressMask = (uintptr_t(1) << 48) - 1;
+  PrintFrame(0, uintptr_t(uc->uc_mcontext.pc));
+  PrintFrame(1, uintptr_t(uc->uc_mcontext.regs[30]) & kAddressMask);
+  uintptr_t stack_start = 0, stack_end = 0;
+  if (!FindMapping(uintptr_t(uc->uc_mcontext.sp), &stack_start, &stack_end)) {
+    return;
+  }
+  uintptr_t fp = uintptr_t(uc->uc_mcontext.regs[29]);
+  for (int i = 2; i < 48; ++i) {
+    if (fp & 7 || fp < stack_start || fp + 16 > stack_end) {
+      break;
+    }
+    const uintptr_t next = reinterpret_cast<const uintptr_t*>(fp)[0];
+    const uintptr_t ret = reinterpret_cast<const uintptr_t*>(fp)[1] & kAddressMask;
+    if (!ret) {
+      break;
+    }
+    PrintFrame(i, ret);
+    if (next <= fp) {
+      break;
+    }
+    fp = next;
+  }
+}
+
+volatile sig_atomic_t g_reported = 0;
+struct sigaction g_previous[NSIG];
+
+const char* SignalName(int signal_number) {
+  switch (signal_number) {
+    case SIGSEGV:
+      return "SIGSEGV";
+    case SIGBUS:
+      return "SIGBUS";
+    case SIGILL:
+      return "SIGILL";
+    case SIGFPE:
+      return "SIGFPE";
+    case SIGABRT:
+      return "SIGABRT";
+    case SIGTRAP:
+      return "SIGTRAP";
+    default:
+      return "signal";
+  }
+}
+
+// Installed for every fatal signal before the runtime starts. The runtime's own handler (exception_handler_posix)
+// takes SIGSEGV/SIGILL over later and calls AndroidReportFatalSignal itself for the faults nobody claims.
+void OnFatalSignal(int signal_number, siginfo_t* info, void* context) {
+  AndroidReportFatalSignal(signal_number, info, context);
+  sigaction(signal_number, &g_previous[signal_number], nullptr);
+  if (signal_number == SIGABRT) {
+    raise(signal_number);
+  }
+  // other signals: returning runs the faulting instruction again, into the previous handler (debuggerd)
+}
+
+// Thread dump for hangs: when <files>/dump_threads appears, every thread of the process is sent SIGUSR2 in turn
+// and logs its own backtrace (unwind tables, so frames without frame pointers are walked too). The file is deleted.
+void OnDumpSignal(int, siginfo_t*, void* context) {
+  char name[32] = {};
+  char path[64];
+  std::snprintf(path, sizeof(path), "/proc/self/task/%d/comm", gettid());
+  int fd = open(path, O_RDONLY | O_CLOEXEC);
+  if (fd >= 0) {
+    ssize_t n = read(fd, name, sizeof(name) - 1);
+    if (n > 0 && name[n - 1] == '\n') {
+      name[n - 1] = 0;
+    }
+    close(fd);
+  }
+  SayF("--- thread %d \"%s\"\n", gettid(), name);
+  WalkFrames(static_cast<ucontext_t*>(context));
+}
+
+void DumpWatchThread() {
+  const char* files = std::getenv("REX_ANDROID_FILES_DIR");
+  if (!files) {
+    return;
+  }
+  char trigger[512];
+  std::snprintf(trigger, sizeof(trigger), "%s/dump_threads", files);
+  for (;;) {
+    sleep(1);
+    if (access(trigger, F_OK) != 0) {
+      continue;
+    }
+    unlink(trigger);
+    SayF("\n*** thread dump\n");
+    if (DIR* dir = opendir("/proc/self/task")) {
+      while (dirent* entry = readdir(dir)) {
+        int tid = std::atoi(entry->d_name);
+        if (tid > 0 && tid != gettid()) {
+          syscall(SYS_tgkill, getpid(), tid, SIGUSR2);
+          usleep(30000);
+        }
+      }
+      closedir(dir);
+    }
+    SayF("*** end of thread dump\n");
+  }
+}
+
+}  // namespace
+
+int GetAndroidApiLevel() {
+  static const int level = android_get_device_api_level();
+  return level;
+}
+
+void AndroidReportFatalSignal(int signal_number, siginfo_t* info, void* context) {
+  if (g_reported) {
+    return;
+  }
+  g_reported = 1;
+  auto* uc = static_cast<ucontext_t*>(context);
+  const uintptr_t pc = uc ? uintptr_t(uc->uc_mcontext.pc) : 0;
+  const uintptr_t fault = info ? reinterpret_cast<uintptr_t>(info->si_addr) : 0;
+  SayF("\n*** FATAL %s (%d) code %d at pc %llx, fault address %llx, thread %d\n", SignalName(signal_number),
+       signal_number, info ? info->si_code : 0, (unsigned long long)pc, (unsigned long long)fault, gettid());
+  if (!uc) {
+    return;
+  }
+  char line[640];
+  int length = 0;
+  for (int r = 0; r < 31 && length < int(sizeof(line)) - 48; ++r) {
+    length += std::snprintf(line + length, sizeof(line) - size_t(length), "%sx%d=%llx", r % 6 ? " " : "\n  ", r,
+                            (unsigned long long)uc->uc_mcontext.regs[r]);
+  }
+  length += std::snprintf(line + length, sizeof(line) - size_t(length), " sp=%llx\n",
+                          (unsigned long long)uc->uc_mcontext.sp);
+  Say(line, size_t(length));
+  PrintMapping("instruction", pc);
+  PrintMapping("address", fault);
+  PrintMapping("stack", uintptr_t(uc->uc_mcontext.sp));
+  WalkFrames(uc);
+  SayF("*** end of crash report\n");
+}
+
+void InitializeAndroid() {
+  static bool initialized = false;
+  if (initialized) {
+    return;
+  }
+  initialized = true;
+  struct sigaction handler;
+  std::memset(&handler, 0, sizeof(handler));
+  handler.sa_sigaction = OnFatalSignal;
+  handler.sa_flags = SA_SIGINFO | SA_ONSTACK;
+  sigemptyset(&handler.sa_mask);
+  for (int signal_number : {SIGSEGV, SIGBUS, SIGILL, SIGFPE, SIGABRT, SIGTRAP}) {
+    sigaction(signal_number, &handler, &g_previous[signal_number]);
+  }
+  struct sigaction dump;
+  std::memset(&dump, 0, sizeof(dump));
+  dump.sa_sigaction = OnDumpSignal;
+  dump.sa_flags = SA_SIGINFO | SA_RESTART;
+  sigemptyset(&dump.sa_mask);
+  sigaction(SIGUSR2, &dump, nullptr);
+  std::thread(DumpWatchThread).detach();
+  // Keep freed memory cached for a while instead of returning it to the kernel at once: the GPU command
+  // processor allocates and frees per draw (in Qualcomm's driver too), and the release/refault cycle showed up
+  // as allocator and kernel time in profiles.
+  mallopt(M_DECAY_TIME, 1);
+  rex::memory::AndroidInitialize();
+  rex::thread::AndroidInitialize();
+}
+
+void ShutdownAndroid() {
+  rex::thread::AndroidShutdown();
+  rex::memory::AndroidShutdown();
+}
+
