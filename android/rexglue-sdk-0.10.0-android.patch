+// android: vulkan_gpu_profile also counts where render passes are ended from (three return addresses, as
+// library offsets for llvm-symbolizer) and logs the most frequent call sites every 3 seconds.
+static void ProfileRenderPassBreak(void* ra0, void* ra1, void* ra2) {
+  struct Site {
+    uintptr_t ra[3];
+    uint32_t count;
+  };
+  static std::vector<Site> sites;
+  static uint64_t window_start_ns = 0;
+  static uint32_t total = 0;
+  const uintptr_t ra[3] = {uintptr_t(ra0), uintptr_t(ra1), uintptr_t(ra2)};
+  bool found = false;
+  for (Site& site : sites) {
+    if (site.ra[0] == ra[0] && site.ra[1] == ra[1] && site.ra[2] == ra[2]) {
+      ++site.count;
+      found = true;
+      break;
+    }
+  }
+  if (!found && sites.size() < 256) {
+    sites.push_back({{ra[0], ra[1], ra[2]}, 1});
+  }
+  ++total;
+  const uint64_t now_ns = uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                       std::chrono::steady_clock::now().time_since_epoch())
+                                       .count());
+  if (!window_start_ns) {
+    window_start_ns = now_ns;
+  }
+  if (now_ns - window_start_ns < 3000000000ull) {
