+void VulkanPipelineCache::SaveVulkanPipelineCache(bool force) {
+  if (vk_pipeline_cache_ == VK_NULL_HANDLE) {
+    return;
+  }
+  const uint64_t now_ms = uint64_t(std::chrono::duration_cast<std::chrono::milliseconds>(
+                                       std::chrono::steady_clock::now().time_since_epoch())
+                                       .count());
+  if (!force) {
+    // At most every 10 seconds, and only after new pipelines.
+    if (!vk_pipeline_cache_unsaved_.load(std::memory_order_relaxed) ||
+        now_ms - vk_pipeline_cache_last_save_ms_.load(std::memory_order_relaxed) < 10000) {
+      return;
+    }
+  }
+  std::unique_lock<std::mutex> lock(vk_pipeline_cache_save_mutex_, std::try_to_lock);
+  if (!lock.owns_lock()) {
+    return;  // Another thread is saving.
+  }
+  vk_pipeline_cache_last_save_ms_.store(now_ms, std::memory_order_relaxed);
+  vk_pipeline_cache_unsaved_.store(0, std::memory_order_relaxed);
+  const ui::vulkan::VulkanDevice* vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  size_t size = 0;
+  if (dfn.vkGetPipelineCacheData(vulkan_device->device(), vk_pipeline_cache_, &size, nullptr) !=
+          VK_SUCCESS ||
+      !size) {
+    return;
+  }
+  std::vector<uint8_t> data(size);
+  if (dfn.vkGetPipelineCacheData(vulkan_device->device(), vk_pipeline_cache_, &size,
+                                 data.data()) != VK_SUCCESS) {
+    return;
+  }
+  // Written next to the file and renamed over it: a kill mid-write leaves the old file.
+  std::filesystem::path temp_path = vk_pipeline_cache_path_;
+  temp_path += ".tmp";
+  FILE* file = rex::filesystem::OpenFile(temp_path, "wb");
+  if (!file) {
+    return;
+  }
+  const bool written = fwrite(data.data(), 1, size, file) == size;
+  fclose(file);
+  std::error_code error;
+  if (written) {
+    std::filesystem::rename(temp_path, vk_pipeline_cache_path_, error);
+  } else {
+    std::filesystem::remove(temp_path, error);
+  }
 }
 
