+// android: SDL3's Java activity (SDLActivity) loads the app as libmain.so and calls SDL_main on its own thread.
+// Before the app runs: the files directory becomes the working directory and REX_ANDROID_FILES_DIR (the
+// executable/user folder, rex/main_android.h), stdout and stderr go to <files>/log.txt (the previous start's log
+// is kept as log.prev.txt), the crash reporter is installed, and <files>/args.txt is appended to argv.
+extern "C" __attribute__((visibility("default"))) int SDL_main(int argc, char* argv[]) {
+  const char* files = SDL_GetAndroidExternalStoragePath();
+  if (!files) {
+    __android_log_print(ANDROID_LOG_ERROR, "rexglue", "no external storage path: %s", SDL_GetError());
+    return EXIT_FAILURE;
+  }
+  setenv("REX_ANDROID_FILES_DIR", files, 1);
+  (void)!chdir(files);
+  std::string log_path = std::string(files) + "/log.txt";
+  std::rename(log_path.c_str(), (std::string(files) + "/log.prev.txt").c_str());
+  if (std::freopen(log_path.c_str(), "w", stdout)) {
+    setvbuf(stdout, nullptr, _IOLBF, 0);
+    dup2(fileno(stdout), fileno(stderr));
+    setvbuf(stderr, nullptr, _IONBF, 0);
+  }
+  __android_log_print(ANDROID_LOG_INFO, "rexglue", "files directory %s, log %s", files, log_path.c_str());
+  rex::InitializeAndroid();
+
+  std::vector<std::string> args;
+  for (int i = 0; i < argc; ++i) {
+    args.emplace_back(argv[i] ? argv[i] : "");
+  }
+  if (args.empty()) {
+    args.emplace_back("rexglue");
+  }
+  if (FILE* file = std::fopen((std::string(files) + "/args.txt").c_str(), "r")) {
+    char word[1024];
+    while (std::fscanf(file, "%1023s", word) == 1) {
+      // NAME=value (no leading dash) sets an environment variable instead, e.g. MCLA_TIMING_LOG=1
+      const char* eq = std::strchr(word, '=');
+      if (word[0] != '-' && eq && eq != word) {
+        std::string name(word, size_t(eq - word));
+        setenv(name.c_str(), eq + 1, 1);
+        std::printf("rexglue android: env %s=%s\n", name.c_str(), eq + 1);
+        continue;
+      }
+      args.emplace_back(word);
+    }
+    std::fclose(file);
+  }
+  std::printf("rexglue android: files %s, api level %d, args:", files, rex::GetAndroidApiLevel());
+  for (const auto& arg : args) {
+    std::printf(" %s", arg.c_str());
+  }
+  std::printf("\n");
+  std::vector<char*> argv_ptrs;
+  for (auto& arg : args) {
+    argv_ptrs.push_back(arg.data());
+  }
+  argv_ptrs.push_back(nullptr);
+  int result = RunWindowedApp(int(args.size()), argv_ptrs.data());
+  std::printf("rexglue android: app returned %d\n", result);
+  std::fflush(stdout);
+  return result;
+}
