@@ -0,0 +1,29 @@
+#pragma once
+/**
+ * android: process-wide Android setup for the runtime (Xenia's main_android, reduced to what ReXGlue uses).
+ * InitializeAndroid() must run once, early, on the main thread (before memory or threads are created):
+ * it installs the crash reporter for fatal signals and resolves the API-level-dependent functions of
+ * rex::memory (ASharedMemory) and rex::thread (pthread_getname_np).
+ *
+ * Files: the app's external files directory (SDL_GetAndroidExternalStoragePath, /sdcard/Android/data/<package>/files)
+ * is the "executable folder" and the user folder of rex::filesystem (REX_ANDROID_FILES_DIR). It holds
+ *   log.txt       stdout + stderr of this start (the previous start's is log.prev.txt)
+ *   args.txt      optional command-line arguments, whitespace-separated (e.g. --log_level=debug)
+ * plus whatever the app keeps next to its executable on other platforms.
+ */
+
