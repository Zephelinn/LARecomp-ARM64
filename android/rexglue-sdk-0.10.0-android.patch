+void VulkanPipelineCache::LoadVulkanPipelineCache(const std::filesystem::path& cache_root) {
+  if (vk_pipeline_cache_ != VK_NULL_HANDLE || !REXCVAR_GET(vulkan_pipeline_cache_file)) {
+    return;
+  }
+  const ui::vulkan::VulkanDevice* vulkan_device = command_processor_.GetVulkanDevice();
+  vk_pipeline_cache_path_ = cache_root / "vulkan_pipeline_cache.bin";
+  std::vector<uint8_t> data;
+  if (FILE* file = rex::filesystem::OpenFile(vk_pipeline_cache_path_, "rb")) {
+    fseek(file, 0, SEEK_END);
+    long size = ftell(file);
+    fseek(file, 0, SEEK_SET);
+    if (size > 0) {
+      data.resize(size_t(size));
+      if (fread(data.data(), 1, data.size(), file) != data.size()) {
+        data.clear();
+      }
+    }
+    fclose(file);
+  }
+  // Only data from this device and driver (VkPipelineCacheHeaderVersionOne).
+  if (!data.empty()) {
+    VkPhysicalDeviceProperties properties;
+    vulkan_device->vulkan_instance()->functions().vkGetPhysicalDeviceProperties(
+        vulkan_device->physical_device(), &properties);
+    uint32_t header[4];
+    bool valid = data.size() >= 16 + VK_UUID_SIZE;
+    if (valid) {
+      std::memcpy(header, data.data(), sizeof(header));
+      valid = header[0] >= 16 + VK_UUID_SIZE && header[1] == VK_PIPELINE_CACHE_HEADER_VERSION_ONE &&
+              header[2] == properties.vendorID && header[3] == properties.deviceID &&
+              !std::memcmp(data.data() + 16, properties.pipelineCacheUUID, VK_UUID_SIZE);
+    }
+    if (!valid) {
+      REXGPU_INFO("VulkanPipelineCache: {} is from another device or driver, starting over",
+                  rex::path_to_utf8(vk_pipeline_cache_path_));
+      data.clear();
+    }
+  }
+  VkPipelineCacheCreateInfo create_info = {};
+  create_info.sType = VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO;
+  create_info.initialDataSize = data.size();
+  create_info.pInitialData = data.empty() ? nullptr : data.data();
+  if (vulkan_device->functions().vkCreatePipelineCache(vulkan_device->device(), &create_info, nullptr,
+                                                       &vk_pipeline_cache_) != VK_SUCCESS) {
+    vk_pipeline_cache_ = VK_NULL_HANDLE;
+    REXGPU_WARN("VulkanPipelineCache: vkCreatePipelineCache failed");
+    return;
+  }
+  REXGPU_INFO("VulkanPipelineCache: driver pipeline cache {} ({} bytes loaded)",
+              rex::path_to_utf8(vk_pipeline_cache_path_), data.size());
+}
