+bool VulkanSharedMemory::CanHoistUpload(uint32_t start, uint32_t length) {
+  if (!REXCVAR_GET(vulkan_hoist_shared_memory_uploads)) {
+    return false;
+  }
+  // Only while a render pass is open (otherwise nothing is split), and only when the buffer is in the
+  // plain read state: pending GPU writes (memexport, resolves) must stay ordered with the upload.
+  if (!command_processor_.deferred_command_buffer().IsRenderPassOpen() ||
+      last_usage_ != Usage::kRead || last_written_range_.second) {
+    return false;
+  }
+  // Earlier draws of the pass must keep seeing the old contents.
+  return !OverlapsPassReads(start, length);
+}
+
+bool VulkanSharedMemory::OverlapsPassReads(uint32_t start, uint32_t length) {
+  SyncPassReads();
+  if (pass_read_all_) {
+    return true;
+  }
+  const uint64_t end = uint64_t(start) + length;
+  for (const std::pair<uint32_t, uint32_t>& range : pass_read_ranges_) {
+    if (range.first < end && uint64_t(range.first) + range.second > start) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void VulkanSharedMemory::SyncPassReads() {
+  const uint64_t serial = command_processor_.deferred_command_buffer().pass_serial();
+  if (pass_read_serial_ != serial) {
+    pass_read_serial_ = serial;
+    pass_read_all_ = false;
+    pass_read_ranges_.clear();
+  }
+}
+
+void VulkanSharedMemory::NoteRangeRead(uint32_t start, uint32_t length) {
+  if (!length) {
+    return;
+  }
+  SyncPassReads();
+  if (pass_read_all_) {
+    return;
+  }
+  if (pass_read_ranges_.size() >= 1024) {
+    pass_read_all_ = true;
+    return;
+  }
+  pass_read_ranges_.emplace_back(start, length);
+}
+
+void VulkanSharedMemory::OnRangesRequested(
+    const std::vector<std::pair<uint32_t, uint32_t>>& ranges) {
+  for (const std::pair<uint32_t, uint32_t>& range : ranges) {
+    NoteRangeRead(range.first, range.second);
+  }
+}
